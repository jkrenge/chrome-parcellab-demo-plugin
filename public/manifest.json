{
  "manifest_version": 3,
  "key": "",
  "name": "parcelLab Demo Layer",
  "description": "Hide elements or replace their contents on demo pages, then reapply those changes automatically on revisit.",
  "version": "0.5.8",
  "action": {
    "default_popup": "popup.html",
    "default_title": "parcelLab Demo Layer",
    "default_icon": {
      "16": "icons/parcellab_extension_icon_16.png",
      "32": "icons/parcellab_extension_icon.png",
      "48": "icons/parcellab_extension_icon_48.png",
      "128": "icons/parcellab_extension_icon.png"
    }
  },
  "icons": {
    "16": "icons/parcellab_extension_icon_16.png",
    "32": "icons/parcellab_extension_icon.png",
    "48": "icons/parcellab_extension_icon_48.png",
    "128": "icons/parcellab_extension_icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "sandbox": {
    "pages": ["track-and-trace-frame.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox; default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.parcellab.com https://product-api.parcellab.com; style-src 'self' 'unsafe-inline' https://cdn.parcellab.com; connect-src https://*.parcellab.com https://*.parcellab.dev; img-src 'self' data: https:; font-src 'self' data: https:; frame-src https:;"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "identity",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["track-and-trace-frame.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
